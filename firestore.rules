rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Contact Inquiries rules
    match /contactInquiries/{inquiryId} {
      allow create: if isValidInquiry(incoming());
      allow get, list, update, delete: if false; // Only manageable via Firebase Console for now
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.email is string && data.email.size() <= 150 && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 10000
        && data.createdAt == request.time
        && (!('targetEmail' in data) || data.targetEmail is string)
        && (!('notificationStatus' in data) || data.notificationStatus is string);
    }
  }
}
