{
  "entities": {
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "Information collected from the contact form",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the person contacting"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the person"
        },
        "message": {
          "type": "string",
          "description": "The strategic inquiry message"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the inquiry was sent"
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    }
  },
  "firestore": {
    "/contactInquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Collection of strategic inquiries from potential partners"
    }
  }
}
